{
  "name": "acuity-reader",
  "private": true,
  "version": "0.1.0",
  "description": "Modern Windows 11 reader and audiobook player",
  "author": "Mark Newman",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run typecheck && vite build && node scripts/assert-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron .",
    "preview": "vite preview",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "lucide-react": "1.47.0",
    "music-metadata": "11.15.0",
    "pdfjs-dist": "4.10.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "jsdom": "30.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-electron": "1.1.2",
    "vite-plugin-electron-renderer": "1.0.0",
    "vitest": "5.0.1"
  }
}
