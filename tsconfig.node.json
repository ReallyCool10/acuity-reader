{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  // src/types.ts is shared with the renderer: the preload bridge is typed against
  // the same MediaItem/LibraryState shapes the UI consumes.
  "include": ["vite.config.ts", "electron/**/*.ts", "src/types.ts"]
}
